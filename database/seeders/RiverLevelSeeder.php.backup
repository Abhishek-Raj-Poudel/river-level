                    ['datetime' => Carbon::now()->subDays([0-9]*)->toISOString(), 'level' => 9.8],
                    ['datetime' => Carbon::now()->subDays([0-9]*)->toISOString(), 'level' => 9.6],
                    ['datetime' => Carbon::now()->subDays([0-9]*)->toISOString(), 'level' => 10.0],
                ],
            ],
        ];

        return $fallbackData;
    }
}
